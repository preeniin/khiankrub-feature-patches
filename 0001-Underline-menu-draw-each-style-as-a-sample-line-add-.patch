+/// A row of the Underline menu: the style drawn as a line (our change). Clicking applies it.
+fn underline_sample(ui: &mut Ui, app: &mut WordApp, label: &str, style: &str) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    let (rect, resp) = ui.allocate_exact_size(vec2(170.0, 24.0), Sense::click());
+    if resp.hovered() {
+        ui.painter().rect_filled(rect, 3.0, t.hover);
+    }
+    let (x0, x1, y) = (rect.left() + 12.0, rect.right() - 12.0, rect.center().y);
+    let p = ui.painter();
+    let ink = t.text;
+    let on = |a: f32, b: f32, w: f32, dy: f32| {
+        p.line_segment([pos2(x0 + a, y + dy), pos2((x0 + b).min(x1), y + dy)], Stroke::new(w, ink));
+    };
+    // A repeating pattern of (length, drawn) pieces along the line.
+    let pattern = |pieces: &[(f32, bool)], w: f32| {
+        let mut x = 0.0;
+        'outer: loop {
+            for (len, drawn) in pieces {
+                if x0 + x >= x1 {
+                    break 'outer;
+                }
+                if *drawn {
+                    on(x, x + len, w, 0.0);
+                }
+                x += len;
+            }
+        }
+    };
+    match style {
+        "double" => {
+            on(0.0, x1 - x0, 1.2, -1.8);
+            on(0.0, x1 - x0, 1.2, 1.8);
+        }
+        "thick" => on(0.0, x1 - x0, 2.8, 0.0),
+        "dotted" => pattern(&[(1.6, true), (2.4, false)], 1.6),
+        "dash" => pattern(&[(6.0, true), (3.5, false)], 1.3),
+        "dotDash" => pattern(&[(6.0, true), (2.5, false), (1.6, true), (2.5, false)], 1.3),
+        "dotDotDash" => pattern(&[(6.0, true), (2.5, false), (1.6, true), (2.5, false), (1.6, true), (2.5, false)], 1.3),
+        "wave" => {
+            let mut pts = Vec::new();
+            let mut x = 0.0;
+            while x0 + x <= x1 {
+                pts.push(pos2(x0 + x, y + (x * std::f32::consts::TAU / 6.0).sin() * 1.8));
+                x += 0.8;
+            }
+            p.add(egui::Shape::line(pts, Stroke::new(1.2, ink)));
+        }
+        _ => on(0.0, x1 - x0, 1.3, 0.0),
+    }
+    let resp = resp.on_hover_text(tl!(label));
+    if resp.clicked() {
+        crate::widgets::run_from_ribbon(app, "format.underline", json!({"style": style}));
+        ui.close();
+    }
+}
+
 pub(crate) fn mi(ui: &mut Ui, app: &mut WordApp, label: &str, id: &str, params: Value) {
     mi_text(ui, app, tl!(label), id, params);
