+//! Icons of our own additions (see OUR-CHANGES.md), drawn in code on a 24-unit grid. Original
+//! artwork: nothing is copied from any other product.
+
+use egui::{Color32, Painter, Pos2, Stroke, vec2};
+
+/// Draws the icon `name` into `r` in `ink`; false when `name` is not one of ours.
+pub fn paint(p: &Painter, r: egui::Rect, name: &str, ink: Color32) -> bool {
+    if name != "charSpacing" {
+        return false;
+    }
+    let size = r.width().min(r.height());
+    if !size.is_finite() || size <= 0.5 || !r.center().is_finite() {
+        return true;
+    }
+    let s = size / 24.0;
+    char_spacing(&Pen { p, o: r.center() - vec2(size, size) * 0.5, s, ink });
+    true
+}
+
+/// A pen on the 24-unit grid.
+struct Pen<'a> {
+    p: &'a Painter,
+    o: Pos2,
+    s: f32,
+    ink: Color32,
+}
+
+impl Pen<'_> {
+    fn at(&self, x: f32, y: f32) -> Pos2 {
+        self.o + vec2(x, y) * self.s
+    }
+    fn line(&self, a: (f32, f32), b: (f32, f32)) {
+        let stroke = Stroke::new((1.4 * self.s).max(0.9), self.ink);
+        self.p.line_segment([self.at(a.0, a.1), self.at(b.0, b.1)], stroke);
+    }
+    fn poly(&self, pts: &[(f32, f32)]) {
+        for w in pts.windows(2) {
+            if let [a, b] = w {
+                self.line(*a, *b);
+            }
+        }
+    }
+}
+
+/// Character spacing: a letter A over a double-headed arrow between two bars.
+fn char_spacing(pen: &Pen) {
+    pen.poly(&[(7.5, 13.0), (12.0, 3.5), (16.5, 13.0)]);
+    pen.line((9.2, 9.6), (14.8, 9.6));
+    pen.line((3.0, 16.0), (3.0, 21.0));
+    pen.line((21.0, 16.0), (21.0, 21.0));
+    pen.line((5.0, 18.5), (19.0, 18.5));
+    pen.poly(&[(8.0, 16.0), (5.0, 18.5), (8.0, 21.0)]);
+    pen.poly(&[(16.0, 16.0), (19.0, 18.5), (16.0, 21.0)]);
+}
